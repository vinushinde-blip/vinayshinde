__pycache__/
*.pyc

# Kite Connect session/credentials — never commit these
scripts/intraday/.kite_session.json
scripts/intraday/_universe_checkpoint.csv
.env

# Raw fetched intraday bars are large and regenerable from Kite — don't commit
data/intraday/bars/
data/intraday/trade_log.csv
# run_backtest.py's default output — regenerable, overwritten on every run;
# commit named snapshots explicitly instead (e.g. backtest_results_uncapped.csv)
data/intraday/backtest_results.csv

# generate_signals.py's daily output — regenerated each trading day, not a repo record
data/intraday/signals/

# capital_backtest.py's output — regenerable, overwritten on every run
data/intraday/capital_equity_curve.csv
data/intraday/capital_trade_log.csv

# scanner outputs — regenerated on every run, not a repo record
data/intraday/scans/

# swing_backtest.py's output — regenerable, overwritten on every run
data/intraday/swing_strategy_trades*.csv
data/intraday/swing_capital_equity_curve*.csv
data/intraday/swing_capital_trade_log*.csv

# swing_pullback_backtest.py's output — regenerable, overwritten on every run
data/intraday/swing_pullback_trades.csv
data/intraday/swing_pullback_equity_curve.csv

# Raw fetched daily bars — large and regenerable from Kite, same as intraday bars
data/daily/bars/
