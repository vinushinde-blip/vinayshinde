//@version=5
indicator("VWAP Distance Zones", overlay = true)

src    = input.source(close, "Source")
anchor = input.string("Session", "Anchor", options = ["Session", "Week", "Month"])

mult1 = input.float(1.0, "Away threshold (x std-dev)")
mult2 = input.float(2.0, "Abnormal Away threshold (x std-dev)")
mult3 = input.float(3.0, "Too Far threshold (x std-dev)")

isNewPeriod = anchor == "Session" ? timeframe.change("D") : anchor == "Week" ? timeframe.change("W") : timeframe.change("M")

var float cumPV  = na
var float cumVol = na
cumPV  := isNewPeriod ? src * volume : cumPV[1] + src * volume
cumVol := isNewPeriod ? volume       : cumVol[1] + volume
vwapValue = cumPV / cumVol

distPct   = (src - vwapValue) / vwapValue * 100
absDist   = math.abs(distPct)
stdevDist = ta.stdev(distPct, 100)

level1 = stdevDist * mult1
level2 = stdevDist * mult2
level3 = stdevDist * mult3

zoneColor = absDist <= level1 ? color.green : absDist <= level2 ? color.orange : absDist <= level3 ? color.yellow : color.red

plot(vwapValue, title = "VWAP", color = zoneColor, linewidth = 2)

distSign = distPct >= 0 ? "+" : "-"

var table info = table.new(position.top_right, 2, 3, border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "VWAP", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(info, 1, 0, str.tostring(vwapValue, format.mintick), text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(info, 0, 1, "Distance", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(info, 1, 1, distSign + str.tostring(absDist, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(info, 0, 2, "Zone", text_color = color.white, bgcolor = zoneColor)
    table.cell(info, 1, 2, "", bgcolor = zoneColor)
